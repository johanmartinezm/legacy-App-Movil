<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Como se exporta el archive a .ipa. Lo usa el workflow de GitHub Actions
	     (.github/workflows/ios-testflight.yml) en el paso de exportArchive. -->

	<key>method</key>
	<string>app-store</string>

	<key>teamID</key>
	<string>87LBVBLK8T</string>

	<!-- manual, no automatic.
	     Apple no permite que una clave de App Store Connect cree certificados
	     ni perfiles de DISTRIBUCION: responde 403 al intentarlo por la API, y
	     "Cloud signing permission error" cuando lo intenta Xcode. Ambos se
	     crean una vez desde el portal web y llegan al runner como secretos, asi
	     que aqui hay que decirle exactamente cual usar. -->
	<key>signingStyle</key>
	<string>manual</string>

	<key>signingCertificate</key>
	<string>Apple Distribution</string>

	<!-- El nombre debe coincidir EXACTAMENTE con el del perfil en el portal. -->
	<key>provisioningProfiles</key>
	<dict>
		<key>co.legacynetwork.legacyapp</key>
		<string>Legacy App Store CI</string>
	</dict>

	<key>uploadSymbols</key>
	<true/>

	<key>compileBitcode</key>
	<false/>

	<key>destination</key>
	<string>export</string>
</dict>
</plist>
