<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Solo para la configuracion Debug: los builds que se lanzan desde Xcode
	     usan el APNs de pruebas (sandbox). Release y Profile usan
	     Runner.entitlements, que declara production, que es lo que exigen
	     TestFlight y la App Store. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Tambien en Debug: si solo estuviera en Release, el login con Apple
	     fallaria al probar desde Xcode y parecerian dos bugs distintos. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- Associated Domains (webcredentials): enlaza la app con el dominio
	     para que iOS ofrezca guardar la contrasena del login en el Llavero y la
	     rellene despues. El dominio publica el archivo que lo autoriza en
	     /.well-known/apple-app-site-association (Sitio-Administrativo/public).
	     Requiere la capability Associated Domains en el App ID y perfiles
	     regenerados despues de activarla: con un perfil viejo, exportArchive
	     falla porque el perfil no incluye este entitlement. 2026-11-13. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>webcredentials:app.legacynetworkco.com</string>
	</array>
</dict>
</plist>
