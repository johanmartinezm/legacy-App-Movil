<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- production, no development: lo usan las configuraciones Release y
	     Profile, que son las que se distribuyen. Con development, iOS entrega
	     un token del APNs de pruebas y las notificaciones NO llegan en builds
	     de TestFlight ni de la App Store, aunque en el simulador y en el
	     dispositivo conectado por cable funcionaran.
	     La configuracion Debug usa RunnerDebug.entitlements. -->
	<key>aps-environment</key>
	<string>production</string>
	<!-- La app llama a SignInWithApple.getAppleIDCredential
	     (auth_provider.dart:256) y sin este entitlement esa llamada falla en
	     ejecucion. Ademas, al ofrecer login con Google, la directriz 4.8 obliga
	     a ofrecer tambien Sign in with Apple: sin esto la revision lo rechaza.
	     La capability APPLE_ID_AUTH ya esta habilitada en el App ID, que es el
	     requisito previo para que la firma no falle. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- Associated Domains (webcredentials): enlaza la app con el dominio
	     para que iOS ofrezca guardar la contrasena del login en el Llavero y la
	     rellene despues. El dominio publica el archivo que lo autoriza en
	     /.well-known/apple-app-site-association (Sitio-Administrativo/public).
	     Requiere la capability Associated Domains en el App ID y perfiles
	     regenerados despues de activarla: con un perfil viejo, exportArchive
	     falla porque el perfil no incluye este entitlement. 2026-11-13. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>webcredentials:app.legacynetworkco.com</string>
	</array>
</dict>
</plist>
